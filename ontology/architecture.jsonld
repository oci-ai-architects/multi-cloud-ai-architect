{
  "@context": {
    "mcaa": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "provider": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology/provider/",
    "plane": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology/plane/",
    "protocol": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology/protocol/",
    "cap": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology/capability/",
    "svc": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology/service/",
    "pattern": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology/pattern/",
    "decision": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology/decision/",
    "risk": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology/risk/",
    "ctl": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology/control/",
    "dcterms": "http://purl.org/dc/terms/",
    "@vocab": "https://github.com/oci-ai-architects/multi-cloud-ai-architect/ontology#",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "subClassOf": { "@id": "rdfs:subClassOf", "@type": "@id" },
    "domain": { "@id": "rdfs:domain", "@type": "@id" },
    "range": { "@id": "rdfs:range", "@type": "@id" },
    "source": { "@id": "dcterms:source", "@type": "@id" },
    "providedBy": { "@type": "@id" },
    "realizes": { "@type": "@id", "@container": "@set" },
    "concernsPlane": { "@type": "@id", "@container": "@set" },
    "requiresCapability": { "@type": "@id", "@container": "@set" },
    "mitigates": { "@type": "@id", "@container": "@set" },
    "usesCapability": { "@type": "@id", "@container": "@set" },
    "settlesDecision": { "@type": "@id", "@container": "@set" },
    "lensQuestion": { "@container": "@set" },
    "speaksProtocol": { "@type": "@id", "@container": "@set" }
  },
  "@id": "mcaa:",
  "label": "Multi-cloud AI architecture ontology",
  "comment": "Providers, services, capabilities, patterns, decisions, risks and controls for agent systems that span more than one cloud. Version 0.1.0, 2026-10-05. Service-to-capability links cite the provider research in docs/research/providers/; confidence says how strong that citation is.",
  "@graph": [
    { "@id": "mcaa:Provider", "@type": "rdfs:Class", "label": "Provider", "comment": "A company whose platform hosts or supplies part of the system." },
    { "@id": "mcaa:Service", "@type": "rdfs:Class", "label": "Service", "comment": "A managed service, framework or SDK offered by one provider." },
    { "@id": "mcaa:Capability", "@type": "rdfs:Class", "label": "Capability", "comment": "A provider-neutral ability an agent system needs. Modelled on the AgentCore service decomposition plus the seven AI Architect planes." },
    { "@id": "mcaa:Plane", "@type": "rdfs:Class", "label": "Plane", "comment": "One of the seven AI Architect planes, 07 experience to 01 model." },
    { "@id": "mcaa:Pattern", "@type": "rdfs:Class", "label": "Pattern", "comment": "A named workflow or orchestration pattern from a public source." },
    { "@id": "mcaa:DecisionType", "@type": "rdfs:Class", "label": "Decision type", "comment": "A decision that is expensive to reverse and gets an ADR." },
    { "@id": "mcaa:Risk", "@type": "rdfs:Class", "label": "Risk" },
    { "@id": "mcaa:Control", "@type": "rdfs:Class", "label": "Control", "comment": "A design or operating measure that mitigates a risk and answers lens questions." },
    { "@id": "mcaa:Protocol", "@type": "rdfs:Class", "label": "Protocol" },

    { "@id": "mcaa:providedBy", "@type": "rdf:Property", "domain": "mcaa:Service", "range": "mcaa:Provider" },
    { "@id": "mcaa:realizes", "@type": "rdf:Property", "domain": "mcaa:Service", "range": "mcaa:Capability" },
    { "@id": "mcaa:speaksProtocol", "@type": "rdf:Property", "domain": "mcaa:Service", "range": "mcaa:Protocol" },
    { "@id": "mcaa:concernsPlane", "@type": "rdf:Property", "domain": "mcaa:Capability", "range": "mcaa:Plane" },
    { "@id": "mcaa:requiresCapability", "@type": "rdf:Property", "domain": "mcaa:Pattern", "range": "mcaa:Capability" },
    { "@id": "mcaa:mitigates", "@type": "rdf:Property", "domain": "mcaa:Control", "range": "mcaa:Risk" },
    { "@id": "mcaa:usesCapability", "@type": "rdf:Property", "domain": "mcaa:Control", "range": "mcaa:Capability" },
    { "@id": "mcaa:settlesDecision", "@type": "rdf:Property", "domain": "mcaa:Control", "range": "mcaa:DecisionType" },

    { "@id": "provider:google-cloud", "@type": "mcaa:Provider", "label": "Google Cloud", "tier": "primary", "research": "docs/research/providers/google-cloud.md" },
    { "@id": "provider:cloudflare", "@type": "mcaa:Provider", "label": "Cloudflare", "tier": "primary", "research": "docs/research/providers/cloudflare.md" },
    { "@id": "provider:vercel", "@type": "mcaa:Provider", "label": "Vercel", "tier": "primary", "research": "docs/research/providers/vercel.md" },
    { "@id": "provider:railway", "@type": "mcaa:Provider", "label": "Railway", "tier": "primary", "research": "docs/research/providers/railway.md" },
    { "@id": "provider:aws", "@type": "mcaa:Provider", "label": "AWS", "tier": "secondary", "research": "docs/research/providers/aws.md" },
    { "@id": "provider:azure", "@type": "mcaa:Provider", "label": "Microsoft Azure", "tier": "secondary", "research": "docs/research/providers/azure.md" },
    { "@id": "provider:oci", "@type": "mcaa:Provider", "label": "Oracle OCI", "tier": "secondary", "research": "docs/research/providers/oracle-oci.md" },

    { "@id": "plane:experience", "@type": "mcaa:Plane", "label": "07 Experience" },
    { "@id": "plane:observability", "@type": "mcaa:Plane", "label": "06 Observability" },
    { "@id": "plane:evaluation", "@type": "mcaa:Plane", "label": "05 Evaluation" },
    { "@id": "plane:orchestration", "@type": "mcaa:Plane", "label": "04 Orchestration" },
    { "@id": "plane:tools", "@type": "mcaa:Plane", "label": "03 Tool surface" },
    { "@id": "plane:context", "@type": "mcaa:Plane", "label": "02 Context and retrieval" },
    { "@id": "plane:model", "@type": "mcaa:Plane", "label": "01 Model access" },

    { "@id": "protocol:mcp", "@type": "mcaa:Protocol", "label": "Model Context Protocol", "version": "2026-07-28", "source": "https://modelcontextprotocol.io/specification/latest" },
    { "@id": "protocol:a2a", "@type": "mcaa:Protocol", "label": "Agent2Agent", "version": "1.0.0", "source": "https://a2a-protocol.org/latest/specification/" },
    { "@id": "protocol:https", "@type": "mcaa:Protocol", "label": "HTTPS" },

    { "@id": "cap:model-access", "@type": "mcaa:Capability", "label": "Model access", "concernsPlane": ["plane:model"] },
    { "@id": "cap:model-gateway", "@type": "mcaa:Capability", "label": "Model gateway: routing, fallback, caching, rate limits", "concernsPlane": ["plane:model"] },
    { "@id": "cap:retrieval", "@type": "mcaa:Capability", "label": "Retrieval and vector search", "concernsPlane": ["plane:context"] },
    { "@id": "cap:long-term-memory", "@type": "mcaa:Capability", "label": "Long-term memory across sessions", "concernsPlane": ["plane:context"] },
    { "@id": "cap:structured-data", "@type": "mcaa:Capability", "label": "Structured data access", "concernsPlane": ["plane:context"] },
    { "@id": "cap:tool-protocol", "@type": "mcaa:Capability", "label": "Tool serving over MCP", "concernsPlane": ["plane:tools"] },
    { "@id": "cap:tool-gateway", "@type": "mcaa:Capability", "label": "Tool gateway: authorisation, audit, tenancy for tools", "concernsPlane": ["plane:tools"] },
    { "@id": "cap:code-sandbox", "@type": "mcaa:Capability", "label": "Isolated code execution", "concernsPlane": ["plane:tools"] },
    { "@id": "cap:browser-automation", "@type": "mcaa:Capability", "label": "Browser automation", "concernsPlane": ["plane:tools"] },
    { "@id": "cap:payments-for-agents", "@type": "mcaa:Capability", "label": "Agent payments", "concernsPlane": ["plane:tools"] },
    { "@id": "cap:agent-harness", "@type": "mcaa:Capability", "label": "Agent loop framework or harness", "concernsPlane": ["plane:orchestration"] },
    { "@id": "cap:agent-runtime", "@type": "mcaa:Capability", "label": "Agent hosting runtime", "concernsPlane": ["plane:orchestration"] },
    { "@id": "cap:agent-state", "@type": "mcaa:Capability", "label": "Session and actor state", "concernsPlane": ["plane:orchestration"] },
    { "@id": "cap:durable-execution", "@type": "mcaa:Capability", "label": "Durable execution: checkpoints, retries, resumable steps", "concernsPlane": ["plane:orchestration"] },
    { "@id": "cap:background-workers", "@type": "mcaa:Capability", "label": "Long-running background workers", "concernsPlane": ["plane:orchestration"] },
    { "@id": "cap:agent-to-agent", "@type": "mcaa:Capability", "label": "Agent-to-agent delegation", "concernsPlane": ["plane:orchestration"] },
    { "@id": "cap:agent-definition-portability", "@type": "mcaa:Capability", "label": "Portable declarative agent definitions", "concernsPlane": ["plane:orchestration"] },
    { "@id": "cap:evaluation", "@type": "mcaa:Capability", "label": "Evaluation and LLM-as-judge", "concernsPlane": ["plane:evaluation"] },
    { "@id": "cap:observability-tracing", "@type": "mcaa:Capability", "label": "Tracing of model calls, tool calls and tokens", "concernsPlane": ["plane:observability"] },
    { "@id": "cap:human-approval", "@type": "mcaa:Capability", "label": "Human approval and interruption", "concernsPlane": ["plane:experience"] },
    { "@id": "cap:web-experience", "@type": "mcaa:Capability", "label": "Streaming web and chat experience", "concernsPlane": ["plane:experience"] },
    { "@id": "cap:edge-compute", "@type": "mcaa:Capability", "label": "Edge compute near the user", "concernsPlane": ["plane:experience", "plane:orchestration"] },
    { "@id": "cap:agent-identity", "@type": "mcaa:Capability", "label": "Agent identity and authorisation", "concernsPlane": [] },
    { "@id": "cap:policy-enforcement", "@type": "mcaa:Capability", "label": "Policy and guardrail enforcement", "concernsPlane": [] },
    { "@id": "cap:secrets-management", "@type": "mcaa:Capability", "label": "Credential brokering and secrets by reference", "concernsPlane": [] },
    { "@id": "cap:agent-registry", "@type": "mcaa:Capability", "label": "Registry of agents, tools and skills", "concernsPlane": [] },
    { "@id": "cap:cost-attribution", "@type": "mcaa:Capability", "label": "Cost visibility and attribution", "concernsPlane": [] },
    { "@id": "cap:prompt-config-management", "@type": "mcaa:Capability", "label": "Prompt and configuration lifecycle", "concernsPlane": [] },

    { "@id": "svc:gcp-agent-platform", "@type": "mcaa:Service", "label": "Gemini Enterprise Agent Platform (formerly Vertex AI): Gemini models, Agent Engine", "providedBy": "provider:google-cloud", "realizes": ["cap:model-access", "cap:agent-runtime"], "source": "https://www.hpcwire.com/aiwire/2026/04/23/google-unveils-gemini-enterprise-agent-platform/", "confidence": "secondary" },
    { "@id": "svc:gcp-adk", "@type": "mcaa:Service", "label": "Agent Development Kit (ADK)", "providedBy": "provider:google-cloud", "realizes": ["cap:agent-harness", "cap:agent-to-agent"], "speaksProtocol": ["protocol:a2a", "protocol:mcp"], "source": "https://github.com/google/adk-python", "confidence": "sourced" },
    { "@id": "svc:gcp-managed-mcp", "@type": "mcaa:Service", "label": "Google-managed remote MCP servers", "providedBy": "provider:google-cloud", "realizes": ["cap:tool-protocol"], "speaksProtocol": ["protocol:mcp"], "source": "https://docs.cloud.google.com/mcp/supported-products", "confidence": "sourced" },
    { "@id": "svc:gcp-mcp-toolbox", "@type": "mcaa:Service", "label": "MCP Toolbox for Databases", "providedBy": "provider:google-cloud", "realizes": ["cap:tool-protocol", "cap:structured-data"], "speaksProtocol": ["protocol:mcp"], "source": "https://github.com/googleapis/mcp-toolbox", "confidence": "sourced" },
    { "@id": "svc:gcp-agents-cli", "@type": "mcaa:Service", "label": "agents-cli (scaffold, eval, observability skills)", "providedBy": "provider:google-cloud", "realizes": ["cap:evaluation", "cap:observability-tracing"], "source": "https://github.com/google/agents-cli", "confidence": "sourced" },
    { "@id": "svc:gcp-cloud-run", "@type": "mcaa:Service", "label": "Cloud Run", "providedBy": "provider:google-cloud", "realizes": ["cap:agent-runtime", "cap:background-workers"], "source": "https://github.com/GoogleCloudPlatform/cloud-run-mcp", "confidence": "unverified", "comment": "The research cites Cloud Run only through its MCP server; its use as an agent runtime was not checked on a primary page." },

    { "@id": "svc:cf-workers", "@type": "mcaa:Service", "label": "Workers", "providedBy": "provider:cloudflare", "realizes": ["cap:edge-compute", "cap:agent-runtime"], "source": "https://developers.cloudflare.com/agents/", "confidence": "sourced" },
    { "@id": "svc:cf-durable-objects", "@type": "mcaa:Service", "label": "Durable Objects", "providedBy": "provider:cloudflare", "realizes": ["cap:agent-state"], "source": "https://developers.cloudflare.com/durable-objects/", "confidence": "sourced" },
    { "@id": "svc:cf-agents-sdk", "@type": "mcaa:Service", "label": "Agents SDK", "providedBy": "provider:cloudflare", "realizes": ["cap:agent-harness", "cap:tool-protocol", "cap:human-approval"], "speaksProtocol": ["protocol:mcp"], "source": "https://github.com/cloudflare/agents", "confidence": "sourced" },
    { "@id": "svc:cf-ai-gateway", "@type": "mcaa:Service", "label": "AI Gateway", "providedBy": "provider:cloudflare", "realizes": ["cap:model-gateway", "cap:observability-tracing"], "source": "https://developers.cloudflare.com/ai-gateway/", "confidence": "sourced" },
    { "@id": "svc:cf-workers-ai", "@type": "mcaa:Service", "label": "Workers AI", "providedBy": "provider:cloudflare", "realizes": ["cap:model-access"], "source": "https://developers.cloudflare.com/workers-ai/", "confidence": "sourced" },
    { "@id": "svc:cf-ai-search", "@type": "mcaa:Service", "label": "AI Search (formerly AutoRAG)", "providedBy": "provider:cloudflare", "realizes": ["cap:retrieval"], "source": "https://developers.cloudflare.com/agents/tools/ai-search/", "confidence": "sourced" },
    { "@id": "svc:cf-sandbox", "@type": "mcaa:Service", "label": "Sandbox SDK", "providedBy": "provider:cloudflare", "realizes": ["cap:code-sandbox"], "source": "https://developers.cloudflare.com/agents/tools/sandbox/", "confidence": "sourced" },
    { "@id": "svc:cf-project-think", "@type": "mcaa:Service", "label": "Project Think (preview harness)", "providedBy": "provider:cloudflare", "realizes": ["cap:agent-harness", "cap:durable-execution"], "source": "https://developers.cloudflare.com/agents/harnesses/think/", "confidence": "sourced", "status": "preview" },
    { "@id": "svc:cf-mcp-portals", "@type": "mcaa:Service", "label": "MCP server portals", "providedBy": "provider:cloudflare", "realizes": ["cap:tool-gateway"], "speaksProtocol": ["protocol:mcp"], "source": "https://developers.cloudflare.com/reference-architecture/diagrams/ai/enterprise-ai-agent-workspace/", "confidence": "sourced" },
    { "@id": "svc:cf-agent-tools", "@type": "mcaa:Service", "label": "Agent tools: Browser, Payments", "providedBy": "provider:cloudflare", "realizes": ["cap:browser-automation", "cap:payments-for-agents"], "source": "https://blog.cloudflare.com/agents-week-in-review/", "confidence": "sourced" },

    { "@id": "svc:vercel-hosting", "@type": "mcaa:Service", "label": "Vercel platform hosting (Next.js)", "providedBy": "provider:vercel", "realizes": ["cap:web-experience"], "source": "https://vercel.com/docs", "confidence": "sourced" },
    { "@id": "svc:vercel-ai-sdk", "@type": "mcaa:Service", "label": "AI SDK 7", "providedBy": "provider:vercel", "realizes": ["cap:agent-harness", "cap:web-experience"], "source": "https://github.com/vercel/ai", "confidence": "sourced" },
    { "@id": "svc:vercel-ai-gateway", "@type": "mcaa:Service", "label": "AI Gateway", "providedBy": "provider:vercel", "realizes": ["cap:model-gateway"], "source": "https://vercel.com/ai-gateway", "confidence": "sourced" },
    { "@id": "svc:vercel-workflow", "@type": "mcaa:Service", "label": "Workflow SDK", "providedBy": "provider:vercel", "realizes": ["cap:durable-execution", "cap:observability-tracing"], "source": "https://github.com/vercel/workflow", "confidence": "sourced" },
    { "@id": "svc:vercel-sandbox", "@type": "mcaa:Service", "label": "Vercel Sandbox", "providedBy": "provider:vercel", "realizes": ["cap:code-sandbox"], "source": "https://github.com/vercel/sandbox", "confidence": "sourced" },
    { "@id": "svc:vercel-chat-sdk", "@type": "mcaa:Service", "label": "Chat SDK", "providedBy": "provider:vercel", "realizes": ["cap:web-experience"], "source": "https://github.com/vercel/chat", "confidence": "sourced" },
    { "@id": "svc:vercel-connect", "@type": "mcaa:Service", "label": "Vercel Connect", "providedBy": "provider:vercel", "realizes": ["cap:secrets-management", "cap:agent-identity"], "source": "https://vercel.com/blog/introducing-vercel-connect", "confidence": "sourced" },
    { "@id": "svc:vercel-mcp-handler", "@type": "mcaa:Service", "label": "mcp-handler", "providedBy": "provider:vercel", "realizes": ["cap:tool-protocol"], "speaksProtocol": ["protocol:mcp"], "source": "https://github.com/vercel-labs/mcp-handler", "confidence": "sourced" },

    { "@id": "svc:railway-service", "@type": "mcaa:Service", "label": "Railway service (container)", "providedBy": "provider:railway", "realizes": ["cap:background-workers", "cap:agent-runtime"], "source": "https://docs.railway.com", "confidence": "sourced" },
    { "@id": "svc:railway-postgres", "@type": "mcaa:Service", "label": "Railway Postgres with pgvector", "providedBy": "provider:railway", "realizes": ["cap:structured-data", "cap:retrieval"], "source": "https://railway.com/deploy/category/ai", "confidence": "unverified", "comment": "pgvector availability on Railway Postgres was not checked on a primary page; the research mentions it only for templates." },
    { "@id": "svc:railway-remote-mcp", "@type": "mcaa:Service", "label": "Railway remote MCP (infrastructure operations)", "providedBy": "provider:railway", "realizes": ["cap:tool-protocol"], "speaksProtocol": ["protocol:mcp"], "source": "https://railway.com/changelog/2026-04-17-remote-mcp", "confidence": "sourced" },

    { "@id": "svc:aws-bedrock", "@type": "mcaa:Service", "label": "Amazon Bedrock (models, guardrails)", "providedBy": "provider:aws", "realizes": ["cap:model-access", "cap:policy-enforcement"], "source": "https://docs.aws.amazon.com/wellarchitected/latest/agentic-ai-lens/agentic-ai-lens.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-runtime", "@type": "mcaa:Service", "label": "AgentCore Runtime", "providedBy": "provider:aws", "realizes": ["cap:agent-runtime"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-harness", "@type": "mcaa:Service", "label": "AgentCore Harness", "providedBy": "provider:aws", "realizes": ["cap:agent-harness"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-memory", "@type": "mcaa:Service", "label": "AgentCore Memory", "providedBy": "provider:aws", "realizes": ["cap:long-term-memory", "cap:agent-state"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-gateway", "@type": "mcaa:Service", "label": "AgentCore Gateway", "providedBy": "provider:aws", "realizes": ["cap:tool-gateway", "cap:tool-protocol"], "speaksProtocol": ["protocol:mcp"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-identity", "@type": "mcaa:Service", "label": "AgentCore Identity", "providedBy": "provider:aws", "realizes": ["cap:agent-identity"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-policy", "@type": "mcaa:Service", "label": "AgentCore Policy (Cedar-compatible)", "providedBy": "provider:aws", "realizes": ["cap:policy-enforcement"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-observability", "@type": "mcaa:Service", "label": "AgentCore Observability (OTEL)", "providedBy": "provider:aws", "realizes": ["cap:observability-tracing"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-evaluations", "@type": "mcaa:Service", "label": "AgentCore Evaluations and Optimization", "providedBy": "provider:aws", "realizes": ["cap:evaluation"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-code-interpreter", "@type": "mcaa:Service", "label": "AgentCore Code Interpreter", "providedBy": "provider:aws", "realizes": ["cap:code-sandbox"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-browser", "@type": "mcaa:Service", "label": "AgentCore Browser", "providedBy": "provider:aws", "realizes": ["cap:browser-automation"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-registry", "@type": "mcaa:Service", "label": "AgentCore Registry", "providedBy": "provider:aws", "realizes": ["cap:agent-registry"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-agentcore-payments", "@type": "mcaa:Service", "label": "AgentCore Payments", "providedBy": "provider:aws", "realizes": ["cap:payments-for-agents"], "source": "https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/what-is-bedrock-agentcore.html", "confidence": "sourced" },
    { "@id": "svc:aws-strands", "@type": "mcaa:Service", "label": "Strands Agents harness-sdk", "providedBy": "provider:aws", "realizes": ["cap:agent-harness", "cap:agent-to-agent"], "speaksProtocol": ["protocol:a2a", "protocol:mcp"], "source": "https://github.com/strands-agents/harness-sdk", "confidence": "sourced" },

    { "@id": "svc:azure-foundry-agent-service", "@type": "mcaa:Service", "label": "Microsoft Foundry Agent Service", "providedBy": "provider:azure", "realizes": ["cap:agent-runtime", "cap:model-access"], "source": "https://github.com/microsoft-foundry/foundry-samples", "confidence": "unverified", "comment": "Model access through Foundry is inferred from the certification page naming; check the Foundry docs before relying on it." },
