    { "@id": "risk:indirect-prompt-injection", "@type": "mcaa:Risk", "label": "Indirect prompt injection through retrieved or fetched content", "lensQuestion": ["AGENTSEC04", "AGENTSEC08"] },
    { "@id": "risk:excessive-agency", "@type": "mcaa:Risk", "label": "Excessive agency and privilege escalation through tools", "lensQuestion": ["AGENTSEC02", "AGENTSEC03"] },
    { "@id": "risk:runaway-loop", "@type": "mcaa:Risk", "label": "Runaway reasoning loop cost and latency", "lensQuestion": ["AGENTCOST01", "AGENTREL02"] },
    { "@id": "risk:provider-outage", "@type": "mcaa:Risk", "label": "Model provider slow, wrong or unavailable", "lensQuestion": ["AGENTREL07", "AGENTREL08"] },
    { "@id": "risk:vendor-lock-in", "@type": "mcaa:Risk", "label": "Swap cost grows unmeasured", "lensQuestion": ["AGENTSUS02"] },
    { "@id": "risk:memory-poisoning", "@type": "mcaa:Risk", "label": "Poisoned or leaked memory and shared state", "lensQuestion": ["AGENTSEC01", "AGENTREL03"] },
    { "@id": "risk:credential-leak", "@type": "mcaa:Risk", "label": "Credential leak across a boundary", "lensQuestion": ["AGENTSEC03"] },
    { "@id": "risk:oversight-bypass", "@type": "mcaa:Risk", "label": "Human oversight bypassed or manipulated", "lensQuestion": ["AGENTSEC07"] },
    { "@id": "risk:silent-regression", "@type": "mcaa:Risk", "label": "Behaviour regresses with no test noticing", "lensQuestion": ["AGENTOPS06"] },
    { "@id": "risk:execution-ceiling", "@type": "mcaa:Risk", "label": "Long task exceeds the platform's execution ceiling", "lensQuestion": ["AGENTREL06", "AGENTPERF05"] },
    { "@id": "risk:untraceable-run", "@type": "mcaa:Risk", "label": "A run cannot be reconstructed after the fact", "lensQuestion": ["AGENTOPS05", "AGENTSEC05"] },

    { "@id": "ctl:retrieved-content-as-data", "@type": "mcaa:Control", "label": "Label retrieved and fetched content as data before it reaches the context window", "mitigates": ["risk:indirect-prompt-injection"], "usesCapability": ["cap:policy-enforcement"], "settlesDecision": ["decision:trust-boundary"], "lensQuestion": ["AGENTSEC04", "AGENTSEC08"] },
    { "@id": "ctl:least-privilege-tools", "@type": "mcaa:Control", "label": "Per-agent tool allow-list with scoped credentials", "mitigates": ["risk:excessive-agency"], "usesCapability": ["cap:tool-gateway", "cap:agent-identity"], "lensQuestion": ["AGENTSEC02", "AGENTSEC03"] },
    { "@id": "ctl:loop-budget-in-code", "@type": "mcaa:Control", "label": "Iteration, token and wall-clock budget enforced in code", "mitigates": ["risk:runaway-loop"], "usesCapability": ["cap:agent-harness"], "settlesDecision": ["decision:orchestration-shape"], "lensQuestion": ["AGENTCOST01", "AGENTREL02"] },
    { "@id": "ctl:gateway-fallback", "@type": "mcaa:Control", "label": "Model gateway with ordered fallback and timeouts", "mitigates": ["risk:provider-outage"], "usesCapability": ["cap:model-gateway"], "lensQuestion": ["AGENTREL07", "AGENTREL08", "AGENTPERF02"] },
    { "@id": "ctl:single-model-seam", "@type": "mcaa:Control", "label": "One module owns every model call", "mitigates": ["risk:vendor-lock-in", "risk:provider-outage"], "usesCapability": ["cap:model-gateway"], "settlesDecision": ["decision:model-call-seam"], "lensQuestion": ["AGENTSUS02", "AGENTPERF02"] },
    { "@id": "ctl:memory-write-validation", "@type": "mcaa:Control", "label": "Validate and scope writes to memory and shared state", "mitigates": ["risk:memory-poisoning"], "usesCapability": ["cap:agent-state", "cap:long-term-memory"], "lensQuestion": ["AGENTSEC01", "AGENTREL03"] },
    { "@id": "ctl:secrets-by-reference", "@type": "mcaa:Control", "label": "Secrets referenced, never passed in prompts or payloads", "mitigates": ["risk:credential-leak"], "usesCapability": ["cap:secrets-management"], "lensQuestion": ["AGENTSEC03"] },
    { "@id": "ctl:approval-for-irreversible", "@type": "mcaa:Control", "label": "Human approval that shows the actual action and arguments for irreversible steps", "mitigates": ["risk:oversight-bypass", "risk:excessive-agency"], "usesCapability": ["cap:human-approval"], "lensQuestion": ["AGENTSEC04", "AGENTSEC07"] },
    { "@id": "ctl:eval-gated-release", "@type": "mcaa:Control", "label": "Release and ADR acceptance gated on eval results", "mitigates": ["risk:silent-regression"], "usesCapability": ["cap:evaluation"], "lensQuestion": ["AGENTOPS06", "AGENTOPS03"] },
    { "@id": "ctl:durable-long-run-home", "@type": "mcaa:Control", "label": "Run long tasks on a platform whose ceiling exceeds the longest real run, with checkpoints", "mitigates": ["risk:execution-ceiling"], "usesCapability": ["cap:durable-execution", "cap:background-workers"], "settlesDecision": ["decision:long-run-home"], "lensQuestion": ["AGENTREL06", "AGENTREL07", "AGENTPERF05"] },
    { "@id": "ctl:end-to-end-tracing", "@type": "mcaa:Control", "label": "One trace per run across model calls, tool calls and delegations", "mitigates": ["risk:untraceable-run"], "usesCapability": ["cap:observability-tracing"], "lensQuestion": ["AGENTOPS05", "AGENTSEC05", "AGENTCOST05"] }
  ]
}
