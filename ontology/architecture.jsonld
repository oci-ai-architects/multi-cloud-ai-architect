    { "@id": "decision:trust-boundary", "@type": "mcaa:DecisionType", "label": "Trust boundary", "source": "../ai-architect/agents/principal-architect.md" },
    { "@id": "decision:long-run-home", "@type": "mcaa:DecisionType", "label": "Long-run home", "source": "../ai-architect/agents/principal-architect.md" },
